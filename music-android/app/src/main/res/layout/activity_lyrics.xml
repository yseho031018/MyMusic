<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyricsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A21"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnLyricsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="가사 화면 닫기"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#CDB8F6"
            android:textSize="20sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MY MUSIC · LYRICS"
            android:textColor="#BAB9C9"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/btnLyricsOptions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="가사 설정"
            android:gravity="center"
            android:text="⋯"
            android:textColor="#D7D6E3"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/lyricsCover"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/lyrics_panel"
            android:contentDescription="앨범 커버"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_placeholder" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lyricsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="재생 중인 음악 없음"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/lyricsArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B4B3C1"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/lyricsSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:text="가사 확인 중…"
        android:textColor="#AAA9B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/lyricsCompanionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="#AAA9B8"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tabSyncedLyrics"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/lyrics_tab_active"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="싱크 가사"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tabFullLyrics"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="전체 가사"
            android:textColor="#AAA9B8"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/lyrics_panel">
        <ScrollView
            android:id="@+id/syncedLyricsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp">
            <LinearLayout
                android:id="@+id/syncedLyricsLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
        <ScrollView
            android:id="@+id/fullLyricsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/fullLyricsLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <SeekBar
        android:id="@+id/lyricsSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progressTint="#CBAEFF"
        android:thumbTint="#E8DBFF" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lyricsPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#AAA9B8"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/lyricsDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#AAA9B8"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lyricsPrevious"
            android:layout_width="60dp"
            android:layout_height="56dp"
            android:contentDescription="이전 곡"
            android:gravity="center"
            android:text="|◀"
            android:textColor="#FFFFFF"
            android:textSize="19sp" />
        <TextView
            android:id="@+id/lyricsPlayPause"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/lyrics_tab_active"
            android:contentDescription="재생 또는 일시정지"
            android:gravity="center"
            android:text="▶"
            android:textColor="#D6BEFF"
            android:textSize="24sp" />
        <TextView
            android:id="@+id/lyricsNext"
            android:layout_width="60dp"
            android:layout_height="56dp"
            android:contentDescription="다음 곡"
            android:gravity="center"
            android:text="▶|"
            android:textColor="#FFFFFF"
            android:textSize="19sp" />
    </LinearLayout>
</LinearLayout>
