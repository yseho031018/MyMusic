<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_eyebrow"
                android:textSize="11sp"
                android:letterSpacing="0.18"
                android:textStyle="bold"
                android:textColor="@color/library_accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/library_title"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/library_text"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/LibraryIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_library_settings"
            android:contentDescription="@string/library_settings"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:orientation="horizontal"
        android:background="@drawable/library_tab_strip">
        <Button
            android:id="@+id/btnTabServer"
            style="@style/LibraryTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_server"/>
        <Button
            android:id="@+id/btnTabLocal"
            style="@style/LibraryTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_local"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/library_search">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_library_search"
            android:importantForAccessibility="no"/>
        <EditText
            android:id="@+id/searchSongs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:background="@null"
            android:hint="@string/library_search_hint"
            android:textColor="@color/library_text"
            android:textColorHint="@color/library_muted"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:autofillHints=""
            android:importantForAutofill="no"/>
        <ImageButton
            android:id="@+id/btnClearSearch"
            style="@style/LibraryIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_library_close"
            android:contentDescription="@string/library_clear_search"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"
            android:text="@string/library_offline_ready"
            android:textColor="@color/library_muted"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:accessibilityLiveRegion="polite"/>
        <Button
            android:id="@+id/btnRemoteStart"
            style="@style/LibraryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_start_server"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/txtLibraryCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/library_text"
            android:textSize="13sp"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btnRefreshMetadata"
            style="@style/LibraryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_refresh_metadata"
            android:contentDescription="@string/library_refresh_metadata_description"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btnImportMp3"
            style="@style/LibraryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_import"
            android:contentDescription="@string/library_import_description"
            android:visibility="gone"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"/>
        <LinearLayout
            android:id="@+id/libraryEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_library_record"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/txtEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/library_text"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/txtEmptyDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/library_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/txtListHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:textColor="@color/library_muted"
        android:textSize="11sp"/>

    <!-- Compact dock; tap artwork/title to open the full turntable. -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/library_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <RelativeLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:contentDescription="@string/library_open_player">
                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#302B3A">
                    <ImageView
                        android:id="@+id/imgCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music_placeholder"
                        android:importantForAccessibility="no"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="54dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">
                    <TextView
                        android:id="@+id/txtNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/library_text"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/txtArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="11sp"
                        android:textColor="@color/library_muted"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
            </RelativeLayout>
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/turntable_play_button"
                android:backgroundTint="@null"
                android:padding="13dp"
                android:src="@drawable/ic_library_play"
                android:contentDescription="@string/library_play"/>
            <ImageButton
                android:id="@+id/btnNext"
                style="@style/LibraryIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_library_next"
                android:contentDescription="@string/library_next"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/txtCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_initial_time"
                android:textSize="11sp"
                android:textColor="@color/library_muted"/>
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/library_accent"
                android:progressBackgroundTint="#494151"
                android:thumbTint="#E5D5FF"
                android:contentDescription="@string/library_seek"/>
            <TextView
                android:id="@+id/txtDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/library_initial_time"
                android:textSize="11sp"
                android:textColor="@color/library_muted"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
