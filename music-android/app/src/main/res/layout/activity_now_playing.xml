<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16161D"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btnNowPlayingBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="재생 화면 닫기"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#CDB8F6"
            android:textSize="20sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NOW PLAYING"
            android:textColor="#C5B5DC"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnNowPlayingCaption"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="싱크 자막 켜기"
            android:gravity="center"
            android:text="CC"
            android:textColor="#D8C5F9"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.example.mymusic.player.TurntableView
        android:id="@+id/turntable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp"
        android:src="@drawable/ic_music_placeholder" />

    <TextView
        android:id="@+id/nowPlayingCaption"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#F3E8FF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nowPlayingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="재생 중인 음악 없음"
        android:textColor="#F6F2FA"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/nowPlayingArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="목록에서 음악을 재생해 주세요"
        android:textColor="#A9A4B2"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/nowPlayingSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:max="1000"
        android:progressTint="#C9A9FF"
        android:thumbTint="#E5D5FF" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/nowPlayingPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#A9A4B2"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/nowPlayingDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#A9A4B2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/nowPlayingPrevious"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="이전 곡"
            android:gravity="center"
            android:text="|◀"
            android:textColor="#F1ECF8"
            android:textSize="21sp" />
        <TextView
            android:id="@+id/nowPlayingPlayPause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:background="@drawable/turntable_play_button"
            android:contentDescription="재생"
            android:gravity="center"
            android:text="▶"
            android:textColor="#24192F"
            android:textSize="25sp" />
        <TextView
            android:id="@+id/nowPlayingNext"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="다음 곡"
            android:gravity="center"
            android:text="▶|"
            android:textColor="#F1ECF8"
            android:textSize="21sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnNowPlayingLyrics"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/turntable_lyrics_button"
        android:contentDescription="현재 곡 가사 보기"
        android:gravity="center"
        android:text="가사 보기  ↗"
        android:textColor="#DFD2F4"
        android:textSize="14sp" />
</LinearLayout>
